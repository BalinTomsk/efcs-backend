# Copy to `.env` for local development (gitignored). Production: the env file mounted via DOTENV_PATH (enc:v1: values).

# MySQL envdata (water/weather store): the account env_service@csnode, REQUIRE SSL.
MYSQL_URL=jdbc:mysql://<envdata-host>:3306/envdata?sslMode=REQUIRED
MYSQL_USERNAME=env_service
MYSQL_PASSWORD=your_mysql_password

# SQL Server (schema env only: env.fn_station_list, env.sp_push_*).
DB_URL=jdbc:sqlserver://host:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Optional: status page heartbeats (adminservice) - all three or none.
RABBITMQ_MANAGEMENT_URL=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
STATUS_MACHINE=csnode
