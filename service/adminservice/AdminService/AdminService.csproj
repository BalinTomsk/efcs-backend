<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdminService</RootNamespace>
    <AssemblyName>AdminService</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NOTE: do NOT enable InvariantGlobalization — Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" at connection open. The runtime image
         installs ICU (libicu) instead. -->
    <!-- Version drives the /health "version" field and the status this service reports about itself. -->
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Workstation, non-concurrent GC (as news_search): the Web SDK defaults to server GC, which reserves far more
         memory than a queue poller needs. csnode is small and shared. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdminService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\**\*" Link="docs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

</Project>
