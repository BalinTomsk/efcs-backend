# NEWSIDX_URL enables the "vector" and "bm25" search sources (news_idx on CTRL). Unset = no search sources.
NEWSIDX_URL=http://news-idx-host:4324

# The news database (MySQL, Winhost `news` table). Enables the news data API (/api/v1/csnews/*) that docapi
# calls. Same three keys docapi used before 0.6.0; a JDBC URL or a native MySqlConnector connection string.
# Unset = every /api/v1/csnews/* route answers 503. enc:v1: values are decrypted with FF_MASTER_KEY_FILE.
MYSQL_NEWS_URL=jdbc:mysql://your-mysql-host:3306/your_database?useSSL=true&serverTimezone=UTC
MYSQL_NEWS_USERNAME=your_username
MYSQL_NEWS_PASSWORD=your_password

# Set false to skip the startup index/trigger check on the news table (default true; best-effort, never fatal).
# NEWS_SCHEMA_BOOTSTRAP=true

# Optional overrides:
# CsNews__Vector__TimeoutSeconds=5
# CsNews__Search__MaxLimit=50

# Service status for the admin page (adminservice). All three RABBITMQ_* set = start/heartbeat/stop are published
# to fishfind.servicestatus.events. STATUS_MACHINE names the host (in Docker the machine name is the container id).
# RABBITMQ_MANAGEMENT_URL=https://your-rabbitmq-host
# RABBITMQ_USERNAME=fishfind
# RABBITMQ_PASSWORD=your_password
# STATUS_MACHINE=csnode

# Status heartbeat period in seconds (service status page). Default and MINIMUM 60: lower values are raised to 60, so a
# service never reports more often than once a minute. Larger values cut RabbitMQ traffic further; then also raise
# ServiceStatusDeadAfterSeconds (frontend Web.config, default 180) to at least 3x this, or healthy services read as dead.
# STATUS_INTERVAL_SECONDS=60
