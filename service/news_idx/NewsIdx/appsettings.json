{
  "NewsIdx": {
    "Qdrant": {
      "Collection": "news_articles",
      "TimeoutSeconds": 30
    },
    "Embedding": {
      "ModelPath": "models/bge-small-en-v1.5/model.onnx",
      "VocabPath": "models/bge-small-en-v1.5/vocab.txt",
      "MaxTokens": 512,
      "Threads": 1,
      "BatchSize": 8
    },
    "Chunking": {
      "ChunkWords": 220,
      "OverlapWords": 40
    },
    "Search": {
      "DefaultLimit": 10,
      "MaxLimit": 50,
      "MaxQueryLength": 256,
      "MinScore": 0.0
    },
    "Bm25": {
      "Collection": "news_articles_bm25",
      "K1": 1.2,
      "B": 0.75,
      "AvgDocLength": 256,
      "TitleWeight": 2
    },
    "Events": {
      "Queue": "fishfind.newsidx.events",
      "PollMilliseconds": 2000,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "MaxBackoffSeconds": 60
    },
    "Sync": {
      "OnStartup": "IfEmpty",
      "IntervalMinutes": 60
    }
  }
}
