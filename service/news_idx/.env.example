# Copy to `.env` for local development (gitignored). In production the env file is mounted and read via
# DOTENV_PATH; real environment variables always take precedence over it. Values may be enc:v1: ciphertext
# (efj-backend/secret/Protect-Env.ps1); then supply FF_MASTER_KEY_FILE=/run/secrets/master.key.

# MySQL news table (Winhost) -- the SAME three keys docapi uses. Leave unset to run with no articles.
MYSQL_NEWS_URL=jdbc:mysql://your-mysql-host:3306/your_database?useSSL=true&serverTimezone=UTC
MYSQL_NEWS_USERNAME=your_username
MYSQL_NEWS_PASSWORD=your_password

# Qdrant gRPC endpoint (port 6334, not the 6333 REST port). API key only if Qdrant is configured with one.
QDRANT_URL=http://localhost:6334
# QDRANT_API_KEY=

# RabbitMQ management HTTP API -- the same broker the frontend's account events use. All three set = the
# news event consumer runs; any missing = no consumer (search and the periodic sync still work).
# RABBITMQ_MANAGEMENT_URL=https://your-rabbitmq-host
# RABBITMQ_USERNAME=fishfind
# RABBITMQ_PASSWORD=your_password

# Optional overrides (double underscore = configuration section nesting):
# NewsIdx__Events__Queue=fishfind.newsidx.events
# NewsIdx__Sync__OnStartup=IfEmpty
# NewsIdx__Sync__IntervalMinutes=60
# NewsIdx__Embedding__Threads=1
# NewsIdx__Search__MinScore=0.0

# Service status for the admin page (adminservice): published with the RABBITMQ_* keys above.
# STATUS_MACHINE names the host (in Docker the machine name is the container id).
# STATUS_MACHINE=vector

# Status heartbeat period in seconds (service status page). Default and MINIMUM 60: lower values are raised to 60, so a
# service never reports more often than once a minute. Larger values cut RabbitMQ traffic further; then also raise
# ServiceStatusDeadAfterSeconds (frontend Web.config, default 180) to at least 3x this, or healthy services read as dead.
# STATUS_INTERVAL_SECONDS=60
