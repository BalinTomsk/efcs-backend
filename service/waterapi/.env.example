# Copy to `.env` for local development (gitignored). In production the env file is mounted and read via
# DOTENV_PATH; real environment variables always take precedence over it.

# Shared JDBC-style URL (same shape as the other backend services). A native SqlClient
# connection string is also accepted. Leave DB_URL unset to run on the in-memory backing (no stations).
DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Values may be enc:v1: ciphertext (efj-backend/secret/Protect-Env.ps1); then supply the key:
# FF_MASTER_KEY_FILE=/run/secrets/master.key

# Optional: point the loader at a .env file elsewhere (defaults to ./.env).
# DOTENV_PATH=/app/.env

# Optional cache overrides (double underscore = configuration section nesting):
# WaterApi__StationCache__RefreshMinutes=15
# WaterApi__StationCache__MaxStaleMinutes=360
# WaterApi__StationCache__WarmOnStartup=true
# WaterApi__StationCache__ClientMaxAgeSeconds=300

# Service status for the admin page (adminservice). All three RABBITMQ_* set = start/heartbeat/stop are published
# to fishfind.servicestatus.events. STATUS_MACHINE names the host (in Docker the machine name is the container id).
# RABBITMQ_MANAGEMENT_URL=https://your-rabbitmq-host
# RABBITMQ_USERNAME=fishfind
# RABBITMQ_PASSWORD=your_password
# STATUS_MACHINE=csnode

# Status heartbeat period in seconds (service status page). Default and MINIMUM 60: lower values are raised to 60, so a
# service never reports more often than once a minute. Larger values cut RabbitMQ traffic further; then also raise
# ServiceStatusDeadAfterSeconds (frontend Web.config, default 180) to at least 3x this, or healthy services read as dead.
# STATUS_INTERVAL_SECONDS=60
