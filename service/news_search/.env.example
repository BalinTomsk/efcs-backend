# NEWSIDX_URL enables the "vector" source (news_idx on CTRL). Unset = no vector source.
NEWSIDX_URL=http://news-idx-host:4324

# Optional overrides:
# NewsSearch__Vector__TimeoutSeconds=5
# NewsSearch__Search__MaxLimit=50

# Service status for the admin page (adminservice). All three RABBITMQ_* set = start/heartbeat/stop are published
# to fishfind.servicestatus.events. STATUS_MACHINE names the host (in Docker the machine name is the container id).
# RABBITMQ_MANAGEMENT_URL=https://your-rabbitmq-host
# RABBITMQ_USERNAME=fishfind
# RABBITMQ_PASSWORD=your_password
# STATUS_MACHINE=csnode

# Status heartbeat period in seconds (service status page). Default and MINIMUM 60: lower values are raised to 60, so a
# service never reports more often than once a minute. Larger values cut RabbitMQ traffic further; then also raise
# ServiceStatusDeadAfterSeconds (frontend Web.config, default 180) to at least 3x this, or healthy services read as dead.
# STATUS_INTERVAL_SECONDS=60
