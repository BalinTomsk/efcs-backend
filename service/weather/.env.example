# Copy to `.env` for local development (gitignored). In production, inject these as real environment
# variables — they always take precedence over the .env file. Values may also be stored as
# `enc:v1:...` ciphertext produced by efj-backend/secret/Protect-Env.ps1 (see SecretCodec).
#
# These are the SAME variable names the Java weather-station-pusher uses where they overlap, so one file
# drives either implementation (EnvironmentAliases maps them onto this service's configuration keys).

# ---------------------------------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------------------------------
# Shared JDBC-style URL. A native SqlClient connection string
# (e.g. "Server=host,1433;Database=db;Encrypt=True;TrustServerCertificate=True") is also accepted.
DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=fishfind;encrypt=true;trustServerCertificate=false
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ---------------------------------------------------------------------------------------------------
# Workers — one section per provider.
#   <PROVIDER>_ENABLE       false stops that worker from starting at all. Defaults to true if omitted,
#                           so a provider is opted OUT explicitly and a new one never needs a config edit.
#   <PROVIDER>_TIMEOUT      seconds between calls to that provider. 0 or absent = derive it, by spreading
#                           <PROVIDER>_DAILY_LIMIT evenly over 12 hours. An explicit value is used
#                           verbatim, including one below the 2s floor that guards the derived path.
#   <PROVIDER>_API_KEY      only where the provider is metered. Blank (or whitespace) = the worker does
#                           not start, even when ENABLE is true — running it keyless would fail every
#                           station and suppress post-processing for the whole country.
#   <PROVIDER>_DAILY_LIMIT  stations attempted per UTC day, enforced across restarts by the ledger.
#                           Also the divisor when TIMEOUT is derived.
# Turning one worker off leaves the others running.
# ---------------------------------------------------------------------------------------------------

# --- Weather.gov (US) --- keyless public feed
# WEATHER_GOV_ENABLE=true
# WEATHER_GOV_TIMEOUT=0
# Weather.gov requires a User-Agent naming a reachable contact.
# WEATHER_GOV_USER_AGENT=efj-backend-weather/1.0 (ops@example.com)
# WEATHER_GOV_DAILY_LIMIT=900

# --- Open-Meteo (CA) --- keyless public feed
# OPEN_METEO_ENABLE=true
# OPEN_METEO_TIMEOUT=0
# OPEN_METEO_DAILY_LIMIT=1400

# --- Weather Canada / MSC GeoMet SWOB (CA) --- keyless public feed
# WEATHER_CANADA_ENABLE=true
# WEATHER_CANADA_TIMEOUT=0
# WEATHER_CANADA_USER_AGENT=efj-backend-weather/1.0 (ops@example.com)
# WEATHER_CANADA_DAILY_LIMIT=900
# WEATHER_CANADA_BBOX_RADIUS_DEGREES=0.05

# --- Visual Crossing (US) --- METERED, key required
# VISUAL_CROSSING_ENABLE=true
# VISUAL_CROSSING_TIMEOUT=0
# VISUAL_CROSSING_API_KEY=
# VISUAL_CROSSING_DAILY_LIMIT=900

# --- Google Weather (US) --- METERED, key required
# GOOGLE_WEATHER_ENABLE=true
# GOOGLE_WEATHER_TIMEOUT=0
# GOOGLE_WEATHER_API_KEY=
# GOOGLE_WEATHER_DAILY_LIMIT=161

# ---------------------------------------------------------------------------------------------------
# Weekly report email (optional). With SMTP_HOST or REPORT_EMAIL_TO unset the report is silently
# skipped -- the weather workers are unaffected either way.
# ---------------------------------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# REPORT_EMAIL_TO=ops@example.com
# REPORT_EMAIL_FROM=weather-service@example.com

# ---------------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------------
# Where the crash marker, incident log and API-usage ledger live. Point this at a mounted volume so
# crash history and daily quota accounting survive a redeploy.
# WEATHER_STATE_DIR=/app/logs/.lifecycle

# Point the loader at a .env file elsewhere (defaults to ./.env).
# DOTENV_PATH=/app/.env

# Any other setting, via the double-underscore section form:
# Weather__Worker__StartupVerificationEnabled=true
# Weather__Worker__ConnectTimeoutMs=15000
# Weather__Worker__ReadTimeoutMs=30000
# Weather__Report__Cron=0 0 8 * * FRI
